{
  "name": "ai-girls-mv",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "鲸鱼娘 MV · 人物设定与三维像素音乐影像制作",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "film": "node 通用模板/cli/film.mjs",
    "new": "node 通用模板/cli/new.mjs",
    "preview": "vite --config 通用模板/preview/vite.config.ts",
    "atlas": "node 通用模板/cast/bake_atlas.mjs",
    "atlas:check": "node 通用模板/cast/bake_atlas.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test \"通用模板/tests/*.test.mjs\" && python3 -m unittest discover -s 通用模板/tests -p \"test_*.py\""
  },
  "dependencies": {
    "@remotion/bundler": "4.0.436",
    "@remotion/player": "4.0.436",
    "@remotion/renderer": "4.0.436",
    "@sparticuz/chromium": "153.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "remotion": "4.0.436",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "5.1.1",
    "puppeteer-core": "^25.17.0",
    "typescript": "5.9.3",
    "vite": "7.3.2"
  }
}
