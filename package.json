{
  "name": "newday",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "鲸鱼娘 AI 运营 · 通用模板（three.js 3D 世界 + 2D 像素纸片人，Remotion 逐帧出片）",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "film": "node 通用模板/cli/film.mjs",
    "new": "node 通用模板/cli/new.mjs",
    "preview": "vite --config 通用模板/preview/vite.config.ts",
    "atlas": "node 通用模板/cast/bake_atlas.mjs",
    "atlas:check": "node 通用模板/cast/bake_atlas.mjs --check",
    "actions": "node 通用模板/cast/source/bake_actions.mjs",
    "walk:check": "node 通用模板/cast/check_walk_frames.mjs",
    "assets:check": "node tools/check_asset_hashes.mjs",
    "assets:write": "node tools/check_asset_hashes.mjs --write",
    "standing:assets": "node tools/copy_standing_assets.mjs",
    "standing:check": "node 人物/立绘/tools/key-tachie.mjs --check",
    "standing:metrics": "node 人物/立绘/tools/key-tachie.mjs --write",
    "generated:validate": "node tools/run_python.mjs tools/generated_assets/validate_generated.py",
    "qa:visual": "node tools/run_python.mjs tools/visual_motion_qa.py --demo --motion-demo",
    "qa:motion": "node tools/run_python.mjs tools/visual_motion_qa.py",
    "capture:film": "node tools/shoot_film_adapter.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.quality.json",
    "test": "node tools/check_readonly_paths.mjs && node --experimental-transform-types --disable-warning=ExperimentalWarning --test \"通用模板/tests/*.test.mjs\" && node tools/run_python.mjs -m unittest discover -s 通用模板/tests -p \"test_*.py\"",
    "qa:all": "npm test && npm run typecheck && npm run atlas:check && npm run whale:qa && npm run walk:check && npm run standing:check && npm run assets:check && npm run generated:validate && npm run generated:postcheck && npm run qa:visual",
    "generated:postcheck": "node 番外MV/若是月亮还没来/源码/tools/process_generated.cjs --check && node 番外MV/若是月亮fable5.2high/源码/tools/process_generated.cjs --check",
    "whale:qa": "node tools/run_python.mjs tools/check_whale_redraw.py",
    "actions:preview": "node 通用模板/actions_preview/server.mjs",
    "clarity:shoot": "node tools/preview_clarity_shot.mjs",
    "rig:preview": "vite --config 通用模板/preview/vite.config.ts --mode rig",
    "readonly:check": "node tools/check_readonly_paths.mjs",
    "readonly:apply": "node tools/check_readonly_paths.mjs --apply"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.436",
    "@remotion/player": "4.0.436",
    "@remotion/renderer": "4.0.436",
    "@sparticuz/chromium": "153.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "remotion": "4.0.436",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "5.1.1",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.17.0",
    "typescript": "5.9.3",
    "vite": "7.3.2"
  }
}
